{
  "name": "dsh-linggo-plugin",
  "version": "0.1.1-alpha.3",
  "description": "LingGo transit workbench for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0",
    "dsh": "0.2.0-rc.2 || 0.2.1-alpha.1 || >=0.2.1-rc.1 <0.2.2-0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "files": [
    "lib/",
    "python/linggo_data/*.py",
    "python/templates/*.py",
    "skills/*.md",
    "python/requirements*.txt",
    "scripts/setup-python.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "COMPATIBILITY.md",
    "docs/compatibility.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/workbench-ui.md",
    "demo/*.json",
    "docs/compose/spec/demo-minimal-drt-v2.md",
    "docs/compose/spec/data-management-batch-import.md",
    "compatibility.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:build": "node scripts/build.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "check:package": "node scripts/check-package.mjs",
    "pack:release": "node scripts/pack-release.mjs",
    "test:python": "node scripts/setup-python.mjs --run-tests",
    "setup:python": "node scripts/setup-python.mjs",
    "test:compat": "node scripts/test-compat.mjs",
    "demo:generate": "python3 scripts/generate-demo.py",
    "demo:check": "python3 scripts/generate-demo.py --check",
    "sync:compat": "node scripts/sync-compat.mjs --write",
    "check:compat": "node scripts/sync-compat.mjs",
    "compat:upstream": "node scripts/check-upstream.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2 || 0.2.1-alpha.1 || >=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.0-rc.2 || 0.2.1-alpha.1 || >=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2 || 0.2.1-alpha.1 || >=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2 || 0.2.1-alpha.1 || >=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2 || 0.2.1-alpha.1 || >=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2 || 0.2.1-alpha.1 || >=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.0-rc.2 || 0.2.1-alpha.1 || >=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2 || 0.2.1-alpha.1 || >=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2 || 0.2.1-alpha.1 || >=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2 || 0.2.1-alpha.1 || >=0.2.1-rc.1 <0.2.2-0"
  },
  "devDependencies": {
    "@baidumap/jsapi-loader": "1.0.0",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "esbuild": "0.25.12"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-layout": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-workspace": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-workspace-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-app-boot": {
      "optional": true
    }
  }
}
